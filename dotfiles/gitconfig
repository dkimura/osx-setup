	name = Daichi Kimura
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHNYERVL4UIMa0Jz6wlRzW87eN/hlTZwuKoFSSCkmW1+
[core]
	autocrlf = false
	safecrlf = true
	quotepath = false
	precomposeunicode = true
	excludesfile = ~/.gitignore_global
[push]
	default = simple
	autoSetupRemote = true
[credential]
	helper =
	helper = osxkeychain
[color]
	diff = auto
	status = auto
	branch = auto
[ghq]
	root = ~/Document/ghq
[init]
	defaultBranch = main
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[include]
	path = ~/.gitconfig.local
